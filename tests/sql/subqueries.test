# Uncorrelated IN-subqueries and scalar subqueries.

statement ok
CREATE TABLE emp (id INTEGER PRIMARY KEY, name TEXT, dept INTEGER, salary INTEGER)

statement ok
CREATE TABLE dept (id INTEGER PRIMARY KEY, name TEXT, active BOOLEAN)

statement ok
INSERT INTO dept VALUES (1, 'Engineering', TRUE), (2, 'Sales', TRUE), (3, 'Archive', FALSE)

statement ok
INSERT INTO emp VALUES (1, 'Lan', 1, 3000), (2, 'Minh', 1, 4200), (3, 'Hoa', 2, 2500), (4, 'Tuấn', 3, 1800), (5, 'Vy', NULL, 2000)

query T rowsort
SELECT name FROM emp WHERE dept IN (SELECT id FROM dept WHERE active)
----
Hoa
Lan
Minh

query T rowsort
SELECT name FROM emp WHERE dept NOT IN (SELECT id FROM dept WHERE active)
----
Tuấn

# Vy's dept is NULL: neither IN nor NOT IN is true for her.
query I
SELECT count(*) FROM emp WHERE dept IN (SELECT id FROM dept) OR dept NOT IN (SELECT id FROM dept)
----
4

query T
SELECT name FROM emp WHERE salary = (SELECT max(salary) FROM emp)
----
Minh

query TI
SELECT name, salary - (SELECT min(salary) FROM emp) FROM emp ORDER BY id LIMIT 2
----
Lan	1200
Minh	2400

# A scalar subquery over no rows is NULL.
query B
SELECT (SELECT id FROM dept WHERE id > 10) IS NULL
----
true

query T
SELECT name FROM dept WHERE id IN (SELECT dept FROM emp WHERE salary > 2800) ORDER BY id
----
Engineering

# Subqueries also work in UPDATE and DELETE.
statement ok
UPDATE emp SET salary = salary + 100 WHERE dept IN (SELECT id FROM dept WHERE name = 'Sales')

query I
SELECT salary FROM emp WHERE id = 3
----
2600

statement ok
DELETE FROM emp WHERE dept NOT IN (SELECT id FROM dept WHERE active)

query I
SELECT count(*) FROM emp
----
4

# INSERT ... SELECT with a subquery filter.
statement ok
CREATE TABLE senior (name TEXT)

statement ok
INSERT INTO senior SELECT name FROM emp WHERE salary > (SELECT avg(salary) FROM emp)

query T rowsort
SELECT name FROM senior
----
Lan
Minh

# The subquery runs once even when used for every row.
query I
SELECT count(*) FROM emp e1, emp e2 WHERE e1.salary < (SELECT max(salary) FROM emp)
----
12

# An IN list of literals mixed with columns.
query T rowsort
SELECT name FROM emp WHERE id IN (1, 3, salary)
----
Hoa
Lan
