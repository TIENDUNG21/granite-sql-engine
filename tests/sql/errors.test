# Name resolution and grouping errors. Messages are part of the interface.

statement ok
CREATE TABLE a (id INTEGER PRIMARY KEY, name TEXT)

statement ok
CREATE TABLE b (id INTEGER PRIMARY KEY, a_id INTEGER)

statement error table "c" does not exist
SELECT * FROM c

statement error did you mean "a"
SELECT * FROM aa

statement error column "nme" does not exist
SELECT nme FROM a

statement error column reference "id" is ambiguous
SELECT id FROM a, b

statement error missing FROM-clause entry for table "z"
SELECT z.id FROM a

statement error column a.missing does not exist
SELECT a.missing FROM a

statement error table name "a" specified more than once
SELECT * FROM a, a

statement error SELECT * with no tables specified is not valid
SELECT *

statement error function nosuch() does not exist
SELECT nosuch(1)

statement error function length() takes 1 argument, got 2
SELECT length('a', 'b')

statement error function length() expects TEXT for argument 1, not column "id" (INTEGER)
SELECT length(id) FROM a

statement error aggregate functions are not allowed in WHERE
SELECT * FROM a WHERE count(*) > 1

statement error aggregate function calls cannot be nested
SELECT max(count(*)) FROM a

statement error column "a.name" must appear in the GROUP BY clause or be used in an aggregate function
SELECT name, count(*) FROM a

statement error column "a.name" must appear in the GROUP BY clause
SELECT id, name FROM a GROUP BY id

statement error ORDER BY position 3 is not in select list
SELECT id FROM a ORDER BY 3

statement error for SELECT DISTINCT, ORDER BY expressions must appear in select list
SELECT DISTINCT name FROM a ORDER BY id

statement error subquery must return one column
SELECT * FROM a WHERE id IN (SELECT id, a_id FROM b)

statement error correlated subqueries are not supported
SELECT * FROM a WHERE id IN (SELECT a_id FROM b WHERE b.a_id = a.id)

statement ok
INSERT INTO a VALUES (1, 'x'), (2, 'y')

statement error more than one row returned by a subquery used as an expression
SELECT (SELECT id FROM a)

statement error LIMIT must not be negative
SELECT * FROM a LIMIT -1

statement error argument of LIMIT must be INTEGER
SELECT * FROM a LIMIT 'x'

statement error column "id" does not exist
SELECT * FROM a LIMIT id

statement error expected a constant expression
SELECT * FROM a LIMIT (SELECT 1)

statement error string literals use single quotes: 'hello'
INSERT INTO a VALUES (3, hello)

statement error syntax_error
SELECT FROM WHERE

statement error index "nope" does not exist
DROP INDEX nope

statement error unknown type "BLOB"
CREATE TABLE x (b BLOB)
